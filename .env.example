# ─────────────────────────────────────────────
# Horison Claude Code Stack — Environment Variables
# Copy to .env and set values for the MCP servers you use.
# Variable names must match those in .mcp.json.
# ─────────────────────────────────────────────

# ─── Keys required (set these for the MCPs you use) ───────────────────────────

# langfuse — Prompt management (list/get/create prompts)
# Project Settings → API Keys. Encode: echo -n "pk-lf-XXX:sk-lf-XXX" | base64
# Then set: LANGFUSE_MCP_AUTH="Basic <base64-output>"
# Regions: cloud.langfuse.com (EU) | us.cloud.langfuse.com | hipaa.cloud.langfuse.com
# (Edit langfuse.url in .mcp.json for US/HIPAA.)
LANGFUSE_MCP_AUTH=

# neo4j — Neo4j Cypher MCP (query your graph via Cypher)
# For Aura: neo4j+s://xxxxxxxx.databases.neo4j.io (note: neo4j+s:// not bolt://)
# For local: bolt://localhost:7687
# Aura credentials: found in your Aura console under instance → Connect
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# horison — Horison app MCP (17 read-only KG / vault / deal tools). Both servers
# authenticate via WorkOS OAuth in the browser (Dynamic Client Registration), so
# there is NOTHING to set here — just run `/mcp` and Authenticate. See the
# `horison-mcp` skill for the full local run-and-edit-tools workflow.
#
#   horison-prod → https://mcp.horison.ai/mcp   (hardcoded; WorkOS Production)
#   horison-dev  → http://localhost:8010/mcp    (default; WorkOS Staging)
#
# horison-dev targets a server you run locally (`make mcp` in agentic-chat-service).
# Optional — repoint it (e.g. at the deployed staging service). Any target must be
# a registered WorkOS resource indicator, or OAuth will reject it:
# DEV_HORISON_MCP_URL=https://staging---horison-mcp-iosxkhzrva-ew.a.run.app/mcp

# ─── Optional / set by Claude Code ──────────────────────────────────────────

# filesystem — Uses project directory. Claude Code usually sets this; override if needed.
# CLAUDE_PROJECT_DIR=/path/to/project

# ─── No env keys (auth in browser or CLI) ───────────────────────────────────

# supabase  — OAuth in browser when first used
# linear    — OAuth in browser when first used
# context7  — No key in .mcp.json; add CONTEXT7_* if required by Upstash
# playwright — No auth
# memory    — No auth
# firebase  — Run: firebase login
# serena    — No auth
